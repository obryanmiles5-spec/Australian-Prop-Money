# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE ANALYTICS & WEB CLARITY
NEXT_PUBLIC_GA_ID="G-ZWRWC5Z63W"
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_SEARCH_CONSOLE_ID=""


# ZOHO MAIL SMTP INTEGRATION (All site forms route to info@australianpropmoney.org)
# Host options: "smtp.zoho.com" (Global) or "smtp.zoho.com.au" (Australia)
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_SECURE="true"
# Your Zoho mailbox address (must be info@australianpropmoney.org)
SMTP_USER="info@australianpropmoney.org"
# Zoho Application-Specific Password (generated under Zoho Account Security > App Passwords)
SMTP_PASS=""
SMTP_FROM="info@australianpropmoney.org"
CONTACT_EMAIL="info@australianpropmoney.org"
ORDER_EMAIL="info@australianpropmoney.org"

# WHATSAPP SUPPORT
NEXT_PUBLIC_WHATSAPP_NUMBER="61468187340"

